# ─── Database ────────────────────────────────────────────────────────────────
# Free PostgreSQL: sign up at https://neon.tech → New Project → copy the connection string
DATABASE_URL=postgresql://user:password@host/goodmatter

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
BASE_PATH=/
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Already generated — copy as-is
JWT_SECRET=bdef8bf75fdd8e89f1099e4d2dda309299d8857f834545b5f421425eff4724a17ef75410403aadc4765e1ec297cd86696178a2118156c138795675777ae04f46

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Required for "Continue with Google" login
# Setup (free, 5 mins): https://console.cloud.google.com
#   → APIs & Services → Credentials → Create OAuth 2.0 Client ID → Web application
#   → Authorised JavaScript origins: https://yourdomain.com (or http://localhost:5173 for dev)
#   → No redirect URI needed (we use Google's id_token flow)
GOOGLE_CLIENT_ID=559012440196-5lgavtc75mnsdkvq2povco3o89k77nt0.apps.googleusercontent.com

# ─── OTP via Email (SMTP) ─────────────────────────────────────────────────────
# Option A — Gmail App Password (easiest, free):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Select app: Mail → device: Other → name it "GoodMatter"
#   3. Copy the 16-char password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=GoodMatter <your-gmail@gmail.com>

# Option B — Resend (better for production, 3000 emails/month free):
#   Sign up at https://resend.com → API Keys → Create
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=GoodMatter <onboarding@resend.dev>

# ─── OTP via SMS — Twilio (only if users log in with phone number) ────────────
# Sign up at https://www.twilio.com → get a free trial number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_Ss4sCC3ipW5ZN8
RAZORPAY_KEY_SECRET=I4v8TslDBub6xXupGAPfTEnm
# Webhook secret: Razorpay Dashboard → Settings → Webhooks → add your endpoint → copy secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
